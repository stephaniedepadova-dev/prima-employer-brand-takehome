---
import '../styles/global.css';
import { nav } from '../layouts';

const jobUrl = 'https://www.helloprima.com/careers/jobs/senior-python-software-engineer-77dc9214-4ed8-470e-93b0-4de8bbb1ccc4';
const technologies = ['Python', 'TDD', 'BDD', 'CI/CD', 'IaC', 'Kafka', 'RabbitMQ'];
const optionalTechnologies = ['AWS', 'Kubernetes', 'Terraform', 'Databricks', 'Airflow', 'Kubeflow'];
const requirements = [
  'Strong Python software engineering experience',
  'Experience with testing practices such as TDD or BDD',
  'Experience with CI/CD, infrastructure as code and scalable systems',
  'Ability to work closely with Product, Data Science and ML Engineering',
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f5f1" />
    <meta name="description" content="Senior Python Software Engineer in Milan at Prima. Work on Machine Learning platforms at scale, with full remote available and a salary range of €40k – €75k per year." />
    <meta name="keywords" content="Senior Python Software Engineer, Machine Learning, ML Platform, Python, Prima, Milan, remote software engineering, engineering careers" />
    <title>Senior Python Software Engineer | Prima Careers</title>
  </head>
  <body class="task2-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href="/prima-employer-brand-takehome/">PRIMA</a>
        <nav class="nav" aria-label="Primary navigation">
          {nav.map((item) => <a href={`/prima-employer-brand-takehome${item.href}`} aria-current={item.href === '/task-2/' ? 'page' : undefined}>{item.label}</a>)}
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="task-hero">
        <div class="shell task-head">
          <div class="task-number"><span class="eyebrow task2-number-label">02 / Make something better</span></div>
          <h1>Turn a job ad into a decision tool.</h1>
          <p class="lead">I selected a real Prima vacancy and redesigned the desktop experience around the questions a candidate needs to answer before applying. The mobile view then adapts the same content model for smaller screens.</p>
        </div>
      </section>

      <section class="section">
        <div class="shell asset-intro">
          <div>
            <div class="eyebrow">Asset selected</div>
            <h2 style="margin-top:10px">Senior Python Software Engineer</h2>
            <p class="lead asset-lead">Prima Careers · Milan · Engineering</p>
          </div>
          <div class="asset-meta-card">
            <span>Permanent</span>
            <span>Full remote available</span>
            <span>€40k – €75k</span>
            <span>ML Platform Domain</span>
          </div>
        </div>
      </section>

      <section class="section task2-section">
        <div class="shell">
          <div class="stage-heading">
            <div>
              <div class="eyebrow">01 / Before</div>
              <h2>Reconstruction of the current vacancy.</h2>
            </div>
            <p class="small">This is a content and hierarchy reconstruction based on the published vacancy. The visual treatment below is a neutral mapping of the information, not a replica of Prima’s live page.</p>
          </div>

          <article class="browser-frame browser-before before-reconstruction">
            <div class="browser-chrome">
              <div class="browser-dots"><i></i><i></i><i></i></div>
              <div class="browser-url">helloprima.com / careers / senior-python-software-engineer</div>
              <div class="browser-label">CONTENT RECONSTRUCTION</div>
            </div>

            <div class="current-recon-hero">
              <div class="current-recon-copy">
                <span class="current-recon-label">Published role</span>
                <h3>Senior Python Software Engineer</h3>
                <p>Are you looking for a new challenge?</p>
                <small>Fancy helping us shape the future of motor insurance?</small>
              </div>
              <div class="current-recon-side">
                <div class="current-recon-facts">
                  <div><b>Location</b><span>Milan</span></div>
                  <div><b>Contract</b><span>Permanent</span></div>
                  <div><b>Working model</b><span>Full remote available</span></div>
                  <div><b>Salary</b><span>€40k – €75k</span></div>
                </div>
                <a class="current-recon-link" href={jobUrl} target="_blank" rel="noreferrer">View the live vacancy ↗</a>
              </div>
            </div>

            <div class="current-recon-body">
              <div class="current-recon-context">
                <span class="current-recon-section-label">Published content</span>
                <div class="current-recon-nav-item"><b>01</b><span>Prima</span></div>
                <div class="current-recon-nav-item"><b>02</b><span>Engineering</span></div>
                <div class="current-recon-nav-item current-recon-nav-item-active"><b>03</b><span>ML Platform Domain</span></div>
                <div class="current-recon-nav-item"><b>04</b><span>Role & requirements</span></div>
                <div class="current-recon-nav-item"><b>05</b><span>Why you’ll love it here</span></div>
              </div>

              <div class="current-recon-content">
                <div class="current-recon-content-block">
                  <span>01 / Company context</span>
                  <h4>Prima and the wider Engineering story</h4>
                  <p>Broader company and function context appears before the most role-specific proposition.</p>
                </div>
                <div class="current-recon-content-block">
                  <span>02 / ML Platform Domain</span>
                  <h4>Foundational platforms for Machine Learning at scale</h4>
                  <p>The distinctive ML Platform context is present, but it arrives after wider context.</p>
                </div>
                <div class="current-recon-content-block">
                  <span>03 / Role & requirements</span>
                  <h4>Responsibilities, requirements and nice-to-haves</h4>
                  <p>The role detail is useful and specific, but the relationship between work, impact and fit can be harder to scan.</p>
                </div>
                <div class="current-recon-content-block">
                  <span>04 / EVP</span>
                  <h4>Work Your Way · Grow with us · Thrive and perform</h4>
                  <p>Broader employer-value content appears later in the journey.</p>
                </div>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section class="section">
        <div class="shell">
          <div class="stage-heading">
            <div>
              <div class="eyebrow">02 / What’s wrong</div>
              <h2>The content is there. The hierarchy should make the decision easier.</h2>
            </div>
            <p class="small">The issue is not missing information. It is the order and retrieval of information for a candidate who is scanning, comparing and deciding.</p>
          </div>

          <div class="friction-grid friction-grid-3">
            <article class="friction-card">
              <span class="friction-number">01</span>
              <h3>Priority information comes late</h3>
              <p>The ML Platform context is distinctive, but the candidate reaches it after broader company and Engineering context.</p>
            </article>
            <article class="friction-card">
              <span class="friction-number">02</span>
              <h3>Impact is harder to scan</h3>
              <p>Responsibilities are present, but the relationship between the work, the problems and the impact is not as immediate as it could be.</p>
            </article>
            <article class="friction-card">
              <span class="friction-number">03</span>
              <h3>Candidate questions are mixed</h3>
              <p>What would I do? Who would I work with? What do I need? How could I grow? What happens next? The answers exist, but the hierarchy makes them harder to retrieve.</p>
            </article>
          </div>

          <div class="usability-strip">
            <div><span class="usability-icon">A</span><div><strong>Scannability</strong><small>Short blocks, clear headings, visible priority.</small></div></div>
            <div><span class="usability-icon">B</span><div><strong>Orientation</strong><small>Persistent section navigation helps candidates move through the role.</small></div></div>
            <div><span class="usability-icon">C</span><div><strong>Action</strong><small>One consistent Apply now action, visible without dominating the experience.</small></div></div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="shell">
          <div class="stage-heading">
            <div>
              <div class="eyebrow">Content layer / SEO · GEO · AEO</div>
              <h2>Optimise the page without making it sound like a search engine wrote it.</h2>
            </div>
            <p class="small">These principles shape the content architecture underneath the redesign. Candidate clarity stays first.</p>
          </div>

          <div class="friction-grid friction-grid-3 search-principles">
            <article class="friction-card">
              <span class="friction-number">SEO</span>
              <h3>Use the language candidates actually search.</h3>
              <p>Lead with the exact role title, location, seniority and core technologies. Keep headings and metadata descriptive and specific.</p>
            </article>
            <article class="friction-card">
              <span class="friction-number">GEO</span>
              <h3>Make entities and relationships explicit.</h3>
              <p>Keep Prima, Senior Python Software Engineer, ML Platform Domain, Machine Learning, Milan, remote working, salary and key collaborators explicit in the page itself.</p>
            </article>
            <article class="friction-card">
              <span class="friction-number">AEO</span>
              <h3>Answer the candidate question directly.</h3>
              <p>Use question-led sections such as What will I work on? Who will I work with? What do I need? How could I grow? What should I expect after I apply?</p>
            </article>
          </div>

          <div class="quote" style="margin-top:16px">
            <p>The goal is not more keywords. It is clearer information, stronger context and direct answers that work for both people and machines.</p>
          </div>
        </div>
      </section>

      <section class="section after-stage">
        <div class="shell">
          <div class="stage-heading">
            <div>
              <div class="eyebrow">03 / After</div>
              <h2>A candidate-first vacancy: clearer on desktop, deliberate on mobile.</h2>
            </div>
            <p class="small">The desktop layout is the primary redesign. The mobile view adapts the same content model for a smaller, thumb-friendly experience.</p>
          </div>

          <div class="responsive-previews">
            <article class="preview-panel desktop-preview">
              <div class="preview-panel-head">
                <div><span class="preview-kicker">PRIMARY UI</span><h3>Desktop</h3></div>
                <span class="preview-device">1440px layout</span>
              </div>

              <div class="browser-frame browser-after">
                <div class="browser-chrome">
                  <div class="browser-dots"><i></i><i></i><i></i></div>
                  <div class="browser-url">helloprima.com / careers / senior-python-software-engineer</div>
                  <div class="browser-label">REDESIGN</div>
                </div>

                <div class="after-hero">
                  <div class="after-crumb">Engineering / Machine Learning Platform</div>
                  <div class="after-hero-grid">
                    <div>
                      <div class="after-eyebrow">Senior Python Software Engineer</div>
                      <h3>Build the platforms that enable Machine Learning at scale at Prima.</h3>
                      <p class="after-intro">Join the ML Platform Domain and help build foundational platforms that support Machine Learning across Prima’s markets, from experimentation to production.</p>
                      <div class="after-facts"><span>Milan</span><span>Permanent</span><span>Full remote available</span><span>€40k – €75k</span></div>
                    </div>
                    <div class="after-apply">
                      <span>Ready to explore the role?</span>
                      <a href={jobUrl} target="_blank" rel="noreferrer">Apply now ↗</a>
                    </div>
                  </div>
                </div>

                <div class="redesign-shell">
                  <aside class="after-nav" aria-label="Role page sections">
                    <a href="#impact">Impact</a>
                    <a href="#work">Work</a>
                    <a href="#need">What you need</a>
                    <a href="#team">Team</a>
                    <a href="#tech">Tech</a>
                    <a href="#growth">Growth</a>
                    <a href="#hiring">Hiring</a>
                    <a href="#why-prima">Why Prima</a>
                  </aside>

                  <div class="desktop-role-layout">
                    <div class="redesign-content">
                      <section id="impact" class="redesign-block">
                        <div class="section-kicker">01 / Your impact</div>
                        <h4>Help build the platform behind Machine Learning at scale.</h4>
                        <div class="impact-grid">
                          <div><b>Scale</b><span>Shared capabilities for Machine Learning across Prima’s markets.</span></div>
                          <div><b>Lifecycle</b><span>Systems supporting experimentation, training, deployment and monitoring.</span></div>
                          <div><b>Collaboration</b><span>Product Managers, Data Scientists, ML Engineers and other technical stakeholders.</span></div>
                        </div>
                      </section>

                      <section id="work" class="redesign-block">
                        <div class="section-kicker">02 / What you’ll work on</div>
                        <div class="role-list">
                          <div><span>01</span><b>Build platform capabilities</b><p>Platform tools, shared services and infrastructure for ML at scale.</p></div>
                          <div><span>02</span><b>Support the ML lifecycle</b><p>Systems supporting experimentation, training, deployment and monitoring.</p></div>
                          <div><span>03</span><b>Solve complex engineering problems</b><p>Reliable, maintainable software with a strong focus on quality and scalability.</p></div>
                          <div><span>04</span><b>Share expertise</b><p>Technical guidance, mentorship and support within the ML Platform Domain.</p></div>
                        </div>
                      </section>

                      <section id="need" class="redesign-block requirements-block">
                        <div>
                          <div class="section-kicker">03 / What you’ll need</div>
                          <h4>Make the fit easy to understand.</h4>
                        </div>
                        <div class="need-list">
                          {requirements.map((item, index) => <div><span>{String(index + 1).padStart(2, '0')}</span><p>{item}</p></div>)}
                        </div>
                      </section>

                      <section id="team" class="redesign-block split-block">
                        <div><div class="section-kicker">04 / Your team</div><h4>Work at the intersection of engineering, ML and product.</h4></div>
                        <div class="team-tags"><span>Product Managers</span><span>Data Scientists</span><span>ML Engineers</span><span>Software Engineers</span></div>
                      </section>

                      <section id="tech" class="redesign-block">
                        <div class="section-kicker">05 / Your engineering environment</div>
                        <h4>Relevant technologies, surfaced without turning the page into a keyword list.</h4>
                        <div class="tech-row">
                          {technologies.map((technology) => <span>{technology}</span>)}
                        </div>
                        <p class="small">Nice to have: {optionalTechnologies.join(', ')}.</p>
                      </section>

                      <section id="growth" class="redesign-block split-block">
                        <div><div class="section-kicker">06 / Your growth</div><h4>See how the role can support your development.</h4></div>
                        <div class="growth-list"><span>Learning resources</span><span>Mentorship</span><span>Tailored growth plan</span></div>
                      </section>

                      <section id="hiring" class="redesign-block">
                        <div class="section-kicker">07 / What to expect</div>
                        <h4>Make the next step clear.</h4>
                        <p>After you apply, use Prima’s company-wide hiring guidance to understand the relevant process and next steps for this role.</p>
                        <a class="text-link" href="https://www.helloprima.com/careers/jobs" target="_blank" rel="noreferrer">Explore hiring guidance ↗</a>
                      </section>

                      <section id="why-prima" class="redesign-block why-prima-block">
                        <div class="section-kicker">08 / Why Prima</div>
                        <h4>Connect the role back to the wider EVP.</h4>
                        <div class="evp-row"><b>Work Your Way</b><b>Grow with us</b><b>Thrive and perform</b></div>
                        <div class="final-apply">
                          <div><strong>Ready to explore the role?</strong><span>Senior Python Software Engineer · Milan · €40k – €75k</span></div>
                          <a href={jobUrl} target="_blank" rel="noreferrer">Apply now ↗</a>
                        </div>
                      </section>
                    </div>

                    <aside class="desktop-rail">
                      <div class="rail-sticky">
                        <div class="rail-card">
                          <div class="eyebrow">Role at a glance</div>
                          <div class="rail-fact"><b>Team</b><span>ML Platform Domain</span></div>
                          <div class="rail-fact"><b>Location</b><span>Milan · Full remote available</span></div>
                          <div class="rail-fact"><b>Level</b><span>Senior</span></div>
                          <div class="rail-fact"><b>Salary</b><span>€40k – €75k</span></div>
                          <a class="rail-apply" href={jobUrl} target="_blank" rel="noreferrer">Apply now ↗</a>
                        </div>
                      </div>
                    </aside>
                  </div>
                </div>
              </div>
            </article>

            <article class="preview-panel mobile-preview">
              <div class="preview-panel-head">
                <div><span class="preview-kicker">RESPONSIVE ADAPTATION</span><h3>Mobile</h3></div>
                <span class="preview-device">390px layout</span>
              </div>

              <div class="phone-shell">
                <div class="phone">
                  <div class="phone-bar"></div>
                  <div class="phone-hero">
                    <div class="phone-kicker">Senior Python Software Engineer</div>
                    <div class="phone-title">Build the platforms behind Machine Learning at scale.</div>
                    <p class="phone-sub">Milan · Permanent · Full remote available · €40k – €75k</p>
                    <div class="phone-meta"><span>ML Platform</span><span>Senior</span><span>Python</span></div>
                  </div>
                  <div class="phone-section">
                    <div class="phone-label">01 / Impact</div>
                    <p>Build foundational platforms that support Machine Learning across Prima’s markets.</p>
                    <div class="phone-cards"><div class="phone-card"><b>Scale</b><span>Shared ML capabilities</span></div><div class="phone-card"><b>Lifecycle</b><span>From experimentation to production</span></div><div class="phone-card"><b>Collaboration</b><span>Product, Data Science and ML Engineering</span></div></div>
                  </div>
                  <div class="phone-section">
                    <div class="phone-label">02 / Work</div>
                    <p>Platform capabilities, ML lifecycle support and complex engineering problems.</p>
                  </div>
                  <div class="phone-section">
                    <div class="phone-label">03 / What you need</div>
                    <p>Strong Python engineering, testing practices, CI/CD and scalable systems.</p>
                  </div>
                  <div class="phone-section">
                    <div class="phone-label">04 / Team</div>
                    <p>Product Managers, Data Scientists and ML Engineers.</p>
                  </div>
                  <div class="phone-section">
                    <div class="phone-label">05 / Tech</div>
                    <div class="phone-pills"><span>Python</span><span>TDD</span><span>BDD</span><span>CI/CD</span><span>IaC</span><span>Kafka</span><span>RabbitMQ</span></div>
                  </div>
                  <div class="phone-section">
                    <div class="phone-label">06 / Growth</div>
                    <p>Learning resources, mentorship and a tailored growth plan.</p>
                  </div>
                  <div class="phone-section">
                    <div class="phone-label">07 / Hiring</div>
                    <p>Clear next-step guidance, linked to Prima’s public hiring information.</p>
                  </div>
                  <div class="phone-section">
                    <div class="phone-label">08 / Why Prima</div>
                    <p>Work Your Way · Grow with us · Thrive and perform.</p>
                  </div>
                  <div class="mobile-sticky-cta">Apply now ↗</div>
                </div>
              </div>
            </article>
          </div>

          <div class="principle-band" style="margin-top:18px">
            <span class="eyebrow">Design rule</span>
            <p>Exact role language + explicit entities + direct answers = stronger discoverability without sacrificing human readability.</p>
            <span>SEO, GEO and AEO stay candidate-first: the goal is not more keywords, but clearer information architecture and better answers at decision moments.</span>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div><div class="eyebrow">02 / Task 2</div><p style="margin-top:8px">Make something better</p></div>
        <a class="small" href="/prima-employer-brand-takehome/sources/">Sources & method →</a>
      </div>
    </footer>

    <style>
      .task2-number-label { font-size:1.15rem; line-height:1.15; font-weight:900; letter-spacing:.06em; }
      .before-reconstruction { box-shadow:0 16px 44px rgba(18,18,18,.05); }
      .current-recon-hero { display:grid; grid-template-columns:minmax(0,1.25fr) minmax(310px,.75fr); gap:44px; padding:40px 42px; background:#fbfaf7; border-bottom:1px solid var(--line); }
      .current-recon-copy { display:grid; align-content:center; gap:10px; }
      .current-recon-label,.current-recon-section-label { font-size:.62rem; letter-spacing:.12em; text-transform:uppercase; font-weight:900; color:var(--muted); }
      .current-recon-copy h3 { max-width:16ch; font-size:clamp(2.2rem,3.8vw,4.2rem); color:var(--prima-navy); }
      .current-recon-copy p { margin:2px 0 0; font-size:1.15rem; font-weight:800; color:var(--text); }
      .current-recon-copy small { color:var(--muted); font-size:.9rem; }
      .current-recon-side { display:grid; align-content:center; gap:16px; }
      .current-recon-facts { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1px; overflow:hidden; border:1px solid var(--line); border-radius:16px; background:var(--line); }
      .current-recon-facts > div { display:grid; gap:4px; padding:15px 16px; background:#fff; }
      .current-recon-facts b { font-size:.61rem; text-transform:uppercase; letter-spacing:.1em; color:var(--muted); }
      .current-recon-facts span { font-size:.84rem; line-height:1.3; font-weight:850; color:var(--prima-navy); }
      .current-recon-link { display:flex; justify-content:center; align-items:center; padding:12px 15px; border:1px solid #cfc6d7; border-radius:12px; background:#fff; color:var(--prima-navy); text-decoration:none; font-size:.78rem; font-weight:900; }
      .current-recon-body { display:grid; grid-template-columns:235px minmax(0,1fr); min-height:430px; background:#fff; }
      .current-recon-context { padding:28px 20px; background:#f2f0eb; border-right:1px solid var(--line); }
      .current-recon-nav-item { display:flex; align-items:center; gap:10px; padding:13px 0; border-bottom:1px solid #ddd8cf; font-size:.76rem; color:var(--muted); }
      .current-recon-nav-item b { width:25px; color:#77736d; font-size:.62rem; }
      .current-recon-nav-item-active { color:var(--prima-navy); font-weight:850; }
      .current-recon-nav-item-active b { color:var(--prima); }
      .current-recon-content { padding:30px 36px; }
      .current-recon-content-block { padding:0 0 22px; margin-bottom:22px; border-bottom:1px solid var(--line); }
      .current-recon-content-block:last-child { margin-bottom:0; }
      .current-recon-content-block > span { font-size:.62rem; letter-spacing:.1em; text-transform:uppercase; font-weight:900; color:var(--muted); }
      .current-recon-content-block h4 { margin-top:7px; font-size:1.25rem; color:var(--prima-navy); }
      .current-recon-content-block p { margin-top:7px; color:var(--muted); font-size:.83rem; max-width:68ch; }

      /* Requirements: full-width candidate-facing component with a deliberate 2×2 desktop grid. */
      .requirements-block { display:block; }
      .requirements-block > div:first-child { max-width:48ch; }
      .requirements-block > .need-list { width:100%; margin-top:22px; }
      .need-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; align-content:start; }
      .need-list > div { display:grid; grid-template-columns:40px minmax(0,1fr); gap:14px; align-items:start; min-height:108px; padding:18px 20px; background:#fff; border:1px solid var(--line); border-radius:16px; box-shadow:0 8px 24px rgba(18,18,18,.05); }
      .need-list > div > span { color:var(--prima); font-size:.74rem; line-height:1; font-weight:950; letter-spacing:.05em; padding-top:3px; }
      .need-list > div > p { margin:0; color:var(--text); font-size:1rem; line-height:1.42; font-weight:700; letter-spacing:-.012em; }
      @media (max-width:900px) {
        .need-list { grid-template-columns:1fr; }
      }
      @media (max-width:759px) {
        .task2-number-label { font-size:1rem; }
        .current-recon-hero { grid-template-columns:1fr; gap:22px; padding:25px 20px; }
        .current-recon-copy h3 { max-width:14ch; font-size:2.35rem; }
        .current-recon-side { gap:12px; }
        .current-recon-facts { grid-template-columns:1fr 1fr; }
        .current-recon-body { grid-template-columns:1fr; }
        .current-recon-context { border-right:0; border-bottom:1px solid var(--line); }
        .current-recon-content { padding:24px 20px; }
        .requirements-block > .need-list { margin-top:18px; }
        .need-list > div { min-height:auto; padding:14px; }
