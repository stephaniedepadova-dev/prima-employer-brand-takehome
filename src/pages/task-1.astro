---
import '../styles/global.css';
import { nav } from '../layouts';
const problems = [
  {
    id: '01',
    label: 'Role experience',
    candidateQuestion: 'Would I want to do this specific job at Prima?',
    problem: 'The role is clearly explained, but the experience of doing that specific job at Prima is not always tangible enough when candidates are deciding whether to apply.',
    why: 'Candidates are not only asking whether they can do the job. They are also asking whether they would want to do it at Prima. That second question needs context: the problems they would work on, the people they would work with, how the team operates and the impact they could have.',
    change: 'Bring more role specific proof closer to the decision to apply. For key vacancies, make the team, the work, the problems being solved, real employee perspectives and potential impact easier to see.',
  },
  {
    id: '02',
    label: 'Career trajectory',
    candidateQuestion: 'Could I see where this role could take me?',
    problem: 'Prima communicates development strongly, but possible career trajectories from a specific role are less tangible.',
    why: 'Prima already has a substantial development framework. The question is not whether development exists, but whether a candidate can picture where a specific role could take them. There is a difference between offering development opportunities and making possible career paths visible.',
    change: 'Make career possibilities more tangible through real examples: technical progression, managerial progression, internal moves, cross functional moves, international opportunities and employee career stories. Present them as examples, not promises.',
  },
  {
    id: '03',
    label: 'Candidate experience consistency',
    candidateQuestion: 'Does the hiring experience match the promise?',
    problem: 'Prima clearly aims to create meaningful interactions throughout the hiring process, but public candidate accounts suggest some inconsistency around timing, communication and closure.',
    why: 'Prima says its interview process was designed to create meaningful connections and interactions, and the process is publicly explained. Public feedback is mixed: some candidates report clear, positive experiences while others mention waiting times, communication or closure. I would therefore describe this as a potential consistency gap, not a universally negative experience.',
    change: 'Create greater consistency across the candidate journey: set clear expectations, communicate timing and next steps, ensure consistent closure and define a clear approach to feedback where appropriate.',
  },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f5f1" />
    <title>Task 1 | Diagnose our Employer Brand</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href="/prima-employer-brand-takehome/">PRIMA</a>
        <nav class="nav" aria-label="Primary navigation">
          {nav.map((item) => <a href={`/prima-employer-brand-takehome${item.href}`} aria-current={item.href === '/task-1/' ? 'page' : undefined}>{item.label}</a>)}
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="task-hero">
        <div class="shell task-head">
          <div class="task-number"><span class="eyebrow task-label-large">01 / Diagnose our Employer Brand</span></div>
          <h1 class="task-title">Diagnose our Employer Brand</h1>
          <p class="lead">A focused diagnosis of where Prima's existing employer-brand proof could work harder for candidates.</p>
        </div>
      </section>

      <section class="section">
        <div class="shell problem-grid">
          {problems.map((p) => (
            <article class="surface card problem">
              <div class="number">{p.id} / {p.label}</div>
              <div>
                <div class="eyebrow">Candidate question</div>
                <p style="margin-top:8px;font-size:1.15rem;font-weight:850;">{p.candidateQuestion}</p>
              </div>
              <div>
                <div class="eyebrow">Problem</div>
                <h3 style="margin-top:8px">{p.problem}</h3>
              </div>
              <div class="problem-body">
                <div>
                  <div class="label">Why it matters</div>
                  <p class="answer" style="margin-top:8px">{p.why}</p>
                </div>
                <div>
                  <div class="label">What I would change first</div>
                  <p class="answer" style="margin-top:8px">{p.change}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section">
        <div class="shell">
          <div class="thread-intro">
            <div>
              <div class="eyebrow">The common thread</div>
              <h2 style="margin-top:10px">Choice → Possibility → <span class="thread-confidence">Confidence</span></h2>
            </div>
            <p class="small">Three moments in the candidate decision journey.<br />The opportunity is to make each one easier to answer with evidence.</p>
          </div>

          <div class="thread-grid">
            {problems.map((p, index) => (
              <article class="surface card thread-card">
                <div class="thread-top">
                  <span class="thread-number">{p.id}</span>
                  {index < problems.length - 1 && <span class="thread-arrow" aria-hidden="true">→</span>}
                </div>
                <div class="eyebrow">{p.label}</div>
                <p class="thread-question">{p.candidateQuestion}</p>
              </article>
            ))}
          </div>

          <div class="thread-takeaway">
            <span class="eyebrow">The opportunity</span>
            <p>Prima already has the proof. The opportunity is to make it more visible,<br class="desktop-opportunity-break" /> more relevant and more useful when<br class="desktop-opportunity-break" /> candidates are deciding.</p>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="shell">
          <article class="surface card card-dark benchmark-card">
            <div class="eyebrow" style="color:#aaa">Benchmark / Mollie</div>
            <div class="benchmark-grid" style="margin-top:18px">
              <div class="benchmark-intro-block">
                <div class="benchmark-mark">Mollie</div>
                <p class="benchmark-description">A relevant example of bringing employer brand proof closer to candidate decision moments.</p>
                <a class="text-link text-link-light" href="https://jobs.mollie.com/" target="_blank" rel="noreferrer">Explore Mollie Careers ↗</a>
              </div>
              <div class="benchmark-content-block">
                <div class="eyebrow" style="color:#aaa">What I would learn</div>
                <div class="benchmark-learnings">
                  <div><strong>01 / Role experience</strong><span>Make team context, contribution and expected impact visible close<br />to the role.</span></div>
                  <div><strong>02 / Career trajectory</strong><span>Use real employee stories and progression examples to make possible paths tangible.</span></div>
                  <div><strong>03 / Candidate experience</strong><span>Set clear expectations around the hiring journey and what candidates should expect.</span></div>
                </div>
                <div class="principle" style="margin-top:20px">Make the right proof tangible at the right candidate decision moment.</div>
                <p class="benchmark-footnote">The lesson is the principle, not Mollie's voice, visual identity, page structure or hiring process.</p>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section class="section">
        <div class="shell grid two">
          <article class="surface card">
            <div class="eyebrow">What I would adapt for Prima</div>
            <h3 style="margin-top:10px">Connect the assets Prima already has.</h3>
            <p class="small" style="margin-top:10px">#PrimaLife, employee stories, departments, development opportunities, benefits, hiring information and role specific content.</p>
          </article>
          <article class="surface card card-prima">
            <div class="eyebrow">What I would not copy</div>
            <h3 style="margin-top:10px">The execution.</h3>
            <p class="small" style="margin-top:10px">Not Mollie's tone of voice, visual identity, content formats, Careers structure or hiring process.</p>
          </article>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div><div class="eyebrow">01 / Task 1</div><p style="margin-top:8px">Diagnose our Employer Brand</p></div>
        <a class="small" href="/prima-employer-brand-takehome/sources/">Sources & method →</a>
      </div>
    </footer>

    <style>
      .task-label-large { font-size: .9rem; line-height: 1.15; font-weight: 900; letter-spacing: .06em; }
      .task-title { max-width: 18ch; font-size: clamp(2.8rem, 8vw, 6.2rem); }

      .thread-intro { grid-template-columns: minmax(0, 1.25fr) minmax(300px, .75fr); align-items: end; gap: 34px; margin-bottom: 24px; }
      .thread-intro h2 { max-width: 18ch; font-size: clamp(2.7rem, 5vw, 4.2rem); line-height: .98; white-space: normal; }
      .thread-confidence { white-space: nowrap; }
      .thread-intro .small { margin-bottom: 3px; max-width: 48ch; }
      .thread-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
      .thread-card { min-height: 176px; gap: 18px; box-shadow: 0 10px 28px rgba(18,18,18,.06); }
      .thread-card .eyebrow { margin-top: 2px; }
      .thread-question { margin-top: 6px; font-size: 1.04rem; line-height: 1.2; }
      .thread-takeaway { margin-top: 18px; padding: 20px 0 0; }
      .thread-takeaway p { max-width: 78ch; }
      .desktop-opportunity-break { display: inline; }

      .benchmark-card { overflow: hidden; }
      .benchmark-grid { grid-template-columns: minmax(220px, .68fr) minmax(0, 1.32fr); gap: 46px; align-items: start; }
      .benchmark-mark { font-size: 2.8rem; }
      .benchmark-description { margin-top: 10px; color: #cfcfcf; max-width: 32ch; }
      .benchmark-content-block { min-width: 0; }
      .benchmark-learnings { display: grid; gap: 0; margin-top: 14px; }
      .benchmark-learnings > div { display: grid; grid-template-columns: minmax(180px, .5fr) minmax(0, 1fr); gap: 18px; align-items: start; padding: 14px 0; border-bottom: 1px solid rgba(255,255,255,.14); }
      .benchmark-learnings > div:first-child { padding-top: 0; }
      .benchmark-learnings strong { display: block; font-size: .84rem; line-height: 1.3; }
      .benchmark-learnings span { display: block; color: #cfcfcf; font-size: .82rem; line-height: 1.45; }
      .benchmark-card .principle { max-width: 22ch; font-size: clamp(2rem, 3.4vw, 3rem); line-height: .98; }
      .benchmark-footnote { margin-top: 14px; color:#cfcfcf; max-width:58ch; }
      .benchmark-card .text-link-light:hover { color: #9a5acd !important; }

      .thread-number { width: auto; height: auto; display: inline-block; border-radius: 0; background: transparent; color: var(--text); font-size: 2.35rem; line-height: .9; font-weight: 950; letter-spacing: -.065em; }
      .number { font-size: 1rem; line-height: 1.2; font-weight: 900; letter-spacing: .02em; color: var(--text); }
      @media (min-width: 1100px) {
        .task-hero .task-head { grid-template-columns: 1fr; gap: 18px; align-items: start; }
        .task-hero .task-head > * { justify-self: start; }
      }
      @media (max-width: 1099px) {
        .thread-intro { grid-template-columns: 1fr; gap: 14px; }
        .thread-intro h2 { max-width: 16ch; }
      }
      @media (max-width: 759px) {
        .task-label-large { font-size: .86rem; }
        .thread-grid { grid-template-columns: 1fr; gap: 12px; }
        .thread-intro h2 { font-size: clamp(2.4rem, 11vw, 3.5rem); max-width: 15ch; }
        .thread-card { min-height: 164px; }
        .thread-number { font-size: 2rem; }
        .number { font-size: .94rem; }
        .benchmark-grid { grid-template-columns: 1fr; gap: 26px; }
        .benchmark-learnings > div { grid-template-columns: 1fr; gap: 5px; padding: 13px 0; }
        .benchmark-card .principle { max-width: 18ch; font-size: 2rem; }
        .desktop-opportunity-break { display: none; }
      }
    </style>
  </body>
</html>
