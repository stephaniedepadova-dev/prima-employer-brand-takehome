---
import '../styles/global.css';
import { nav } from '../layouts';

const stages = [
  {
    no: '01',
    title: 'Candidates received',
    subtitle: 'Applications entering the recruitment process',
    volume: 'Applications received',
    conversion: 'Conversion to screening',
    time: 'Time to first review',
    tone: 'purple',
    funnelWidth: '100%',
    passWidth: '24%'
  },
  {
    no: '02',
    title: 'CV screening',
    subtitle: 'Initial review against role requirements',
    volume: 'CVs screened',
    conversion: 'Screening pass rate',
    time: 'Time in screening',
    tone: 'violet',
    funnelWidth: '91%',
    passWidth: '34%',
    exampleRate: '40%'
  },
  {
    no: '03',
    title: 'Assessment / tests',
    subtitle: 'Early-stage assessment to further narrow the candidate pool',
    volume: 'Candidates assessed',
    conversion: 'Pass-through to screening',
    time: 'Time to assessment result',
    tone: 'blue',
    funnelWidth: '82%',
    passWidth: '44%'
  },
  {
    no: '04',
    title: 'Initial screening',
    subtitle: 'Recruiter / HR contact and qualification',
    volume: 'Candidates contacted',
    conversion: 'Progression to interview',
    time: 'Time to screening call',
    tone: 'teal',
    funnelWidth: '73%',
    passWidth: '54%',
    exampleRate: '55%'
  },
  {
    no: '05',
    title: 'Interviews',
    subtitle: 'Recruiter and Hiring Manager interview stages',
    volume: 'Candidates interviewed',
    conversion: 'Progression to shortlist',
    time: 'Time across interview stages',
    tone: 'green',
    funnelWidth: '64%',
    passWidth: '64%',
    exampleRate: '65%'
  },
  {
    no: '06',
    title: 'Shortlist / final decision',
    subtitle: 'Final candidate evaluation and decision',
    volume: 'Candidates in shortlist',
    conversion: 'Progression to offer',
    time: 'Time to final decision',
    tone: 'green-mid',
    funnelWidth: '55%',
    passWidth: '74%',
    exampleRate: '80%'
  },
  {
    no: '07',
    title: 'Offer',
    subtitle: 'Offer presented to the selected candidate',
    volume: 'Offers made',
    conversion: 'Offer acceptance rate',
    time: 'Time from decision to offer',
    tone: 'green-soft',
    funnelWidth: '46%',
    passWidth: '84%',
    exampleRate: '90%'
  },
  {
    no: '08',
    title: 'Acceptance / hire',
    subtitle: 'Accepted offer and transition to hire',
    volume: 'Hires',
    conversion: 'Acceptance / hire rate',
    time: 'Time to hire',
    tone: 'green-final',
    funnelWidth: '38%',
    passWidth: '94%',
    exampleRate: '90%'
  }
];

const illustrativeCurve = [
  { label: 'CV screening', rate: '40%' },
  { label: 'Interviews', rate: '65%' },
  { label: 'Shortlist', rate: '80%' },
  { label: 'Offer', rate: '90%' }
];

const metrics = [
  {
    title: 'Volume',
    text: 'How many candidates are present at each stage.'
  },
  {
    title: 'Conversion / drop-off',
    text: 'How many candidates move forward, and where candidates are lost.'
  },
  {
    title: 'Time in stage',
    text: 'How long candidates remain in each step of the process.'
  }
];

const questions = [
  'Where do candidates drop?',
  'Where does time accumulate?',
  'Which stage becomes the bottleneck?',
  'Which source converts best?',
  'Which stage has the highest or lowest pass-through rate?'
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f5f1" />
    <meta
      name="description"
      content="Operational recruitment funnel framework: volume, conversion and time across the candidate selection process."
    />
    <title>Recruitment Funnel | Prima Take-home</title>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href="/prima-employer-brand-takehome/">PRIMA</a>
        <nav class="nav" aria-label="Primary navigation">
          {nav.map((item) => (
            <a
              href={`/prima-employer-brand-takehome${item.href}`}
              aria-current={item.href === '/recruitment-funnel/' ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="task-hero funnel-hero">
        <div class="shell funnel-head">
          <div class="task-number">
            <span class="eyebrow task-label-large">Recruitment process / operational view</span>
          </div>
          <h1 class="task-title">Recruitment funnel</h1>
          <p class="lead">
            From candidate application to hire: a structured view of volume, conversion and timing at every stage.
          </p>
          <div class="funnel-note">
            <span class="eyebrow">The purpose</span>
            <strong>Make the process visible enough to understand where candidates move, where they drop, and where time accumulates.</strong>
          </div>
        </div>
      </section>

      <section class="section funnel-section">
        <div class="shell funnel-layout">
          <div class="funnel-main">
            <div class="funnel-kicker">
              <div>
                <div class="eyebrow">Operational funnel</div>
                <h2>From application to hire</h2>
              </div>
              <p class="small">Illustrative framework. Candidate volume narrows by stage, while pass-through rate generally increases as the pool becomes more qualified. Actual volumes, conversion rates and timings depend on role, source mix and process.</p>
            </div>

            <div class="funnel-flow">
              {stages.map((stage, index) => (
                <div class="funnel-stage-wrap">
                  <article class={`funnel-stage tone-${stage.tone}`} style={`--funnel-width: ${stage.funnelWidth}`}>
                    <div class="stage-index">{stage.no}</div>
                    <div class="stage-copy">
                      <h3>{stage.title}</h3>
                      <p>{stage.subtitle}</p>
                    </div>
                    <div class="stage-metrics">
                      <div>
                        <span class="metric-label">Volume</span>
                        <strong>{stage.volume}</strong>
                      </div>
                      <div>
                        <span class="metric-label">Pass-through / drop-off</span>
                        <strong>{stage.conversion}</strong>
                      </div>
                      <div>
                        <span class="metric-label">Time in stage</span>
                        <strong>{stage.time}</strong>
                      </div>
                    </div>
                    <div class="pass-through-visual" aria-label="Illustrative pass-through progression">
                      <span class="metric-label">Pass-through progression</span>
                      {stage.exampleRate && <strong class="example-rate">{stage.exampleRate}</strong>}
                      <div class="pass-track">
                        <span class="pass-fill" style={'width: ' + stage.passWidth}></span>
                      </div>
                    </div>
                  </article>

                  {index < stages.length - 1 && (
                    <div class="funnel-arrow" aria-hidden="true">↓</div>
                  )}
                </div>
              ))}
              <section class="illustrative-curve" aria-labelledby="illustrative-curve-title">
                <div class="eyebrow">Illustrative conversion curve</div>
                <h3 id="illustrative-curve-title">Front-loaded screening, stronger pass-through later</h3>
                <div class="curve-grid">
                  {illustrativeCurve.map((point) => (
                    <div class="curve-point">
                      <div class="curve-rate">{point.rate}</div>
                      <div class="curve-bar"><span style={'height: ' + point.rate}></span></div>
                      <strong>{point.label}</strong>
                    </div>
                  ))}
                </div>
                <p class="funnel-example-caption">
                  <strong>Example scenario:</strong> front-loading the screening protects stakeholder time in the later stages by moving forward candidates who already meet core requirements.
                </p>
              </section>
            </div>
          </div>

          <aside class="funnel-rail">
            <article class="surface card rail-card">
              <div class="eyebrow">Key metrics</div>
              <h3>What to monitor</h3>
              <div class="rail-list">
                {metrics.map((metric) => (
                  <div class="rail-item">
                    <span class="rail-icon" aria-hidden="true">↗</span>
                    <div>
                      <strong>{metric.title}</strong>
                      <p>{metric.text}</p>
                    </div>
                  </div>
                ))}
              </div>
            </article>

            <article class="surface card rail-card rail-purple">
              <div class="eyebrow">What the funnel should make visible</div>
              <h3>Questions worth answering</h3>
              <div class="question-list">
                {questions.map((question, index) => (
                  <div class="question-item">
                    <span>0{index + 1}</span>
                    <strong>{question}</strong>
                  </div>
                ))}
              </div>
            </article>
          </aside>
        </div>
      </section>

      <section class="section">
        <div class="shell">
          <article class="surface card funnel-bottom">
            <div>
              <div class="eyebrow">Why it matters</div>
              <h2>From numbers<br />to action.</h2>
            </div>
            <div class="bottom-copy">
              <p>
                The funnel is not only a reporting view. It helps connect candidate flow with process design:
                identify drop-off points, understand delays, test targeted improvements and keep the candidate experience visible alongside operational efficiency.
              </p>
              <div class="conversion-principle">
                <span class="eyebrow">Conversion principle</span>
                <p>
                  A healthy funnel generally shows a rising pass-through rate stage by stage:
                  broader, decisive filtering early, with progressively higher pass-through rates as candidates move closer to offer and hire.
                  Late-stage drop-off is more costly to recover from.
                </p>
              </div>
            </div>
          </article>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <div class="eyebrow">Recruitment funnel</div>
          <p style="margin-top:8px">Operational recruitment process framework</p>
        </div>
        <a class="small" href="/prima-employer-brand-takehome/sources/">Sources & method →</a>
      </div>
    </footer>

    <style>
      .funnel-head { display: grid; gap: 18px; }
      .funnel-hero { padding-bottom: 34px; }
      .funnel-note {
        display: grid;
        gap: 8px;
        max-width: 760px;
        padding: 18px 20px;
        background: var(--prima-soft);
        border: 1px solid #dbc7ef;
        border-radius: var(--radius-sm);
      }
      .funnel-note strong { max-width: 70ch; font-size: 1rem; line-height: 1.4; }

      .funnel-layout {
        display: grid;
        gap: 22px;
        align-items: start;
      }
      .funnel-main { min-width: 0; }
      .funnel-kicker {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(220px, .55fr);
        gap: 20px;
        align-items: end;
        margin-bottom: 24px;
      }
      .funnel-kicker h2 { margin-top: 8px; max-width: 18ch; }

      .funnel-flow { display: grid; gap: 0; }
      .funnel-stage-wrap { display: grid; justify-items: center; }
      .funnel-stage {
        width: min(var(--funnel-width, 100%), 100%);
        min-width: 660px;
        display: grid;
        grid-template-columns: 48px minmax(205px, 1.05fr) minmax(0, 1.8fr);
        gap: 14px;
        align-items: center;
        padding: 17px 18px;
        border: 1px solid transparent;
        border-radius: 18px;
        box-shadow: 0 9px 25px rgba(18,18,18,.045);
      }

      .tone-purple { background: #8334c2; color: #fff; }
      .tone-violet { background: #9b57d1; color: #fff; }
      .tone-blue { background: #5f8fcd; color: #fff; }
      .tone-teal { background: #3d9caa; color: #fff; }
      .tone-green { background: #65b48b; color: #fff; }
      .tone-green-mid { background: #86c89b; color: #fff; }
      .tone-green-soft { background: #b5dca8; color: #17231d; }
      .tone-green-final { background: #d6edc9; color: #17231d; }

      .stage-index {
        width: 42px;
        height: 42px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: rgba(255,255,255,.17);
        border: 1px solid rgba(255,255,255,.3);
        font-size: .82rem;
        font-weight: 950;
      }
      .tone-green-soft .stage-index,
      .tone-green-final .stage-index {
        background: rgba(255,255,255,.62);
        border-color: rgba(33,40,58,.1);
      }
      .stage-copy h3 {
        font-size: clamp(1.1rem, 2.4vw, 1.55rem);
        letter-spacing: -.035em;
      }
      .stage-copy p {
        margin-top: 4px;
        margin-bottom: 0;
        opacity: .85;
        font-size: .8rem;
        line-height: 1.3;
      }

      /* Keep the funnel width narrowing while giving the last two stages enough room for metrics. */
      .funnel-stage-wrap:nth-child(7) .funnel-stage,
      .funnel-stage-wrap:nth-child(8) .funnel-stage {
        grid-template-columns: 42px minmax(0, 1fr);
        align-items: start;
      }
      .funnel-stage-wrap:nth-child(7) .stage-metrics,
      .funnel-stage-wrap:nth-child(8) .stage-metrics {
        grid-column: 2;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        margin-top: 2px;
      }
      .stage-metrics {
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: 12px;
      }
      .stage-metrics > div {
        min-width: 0;
        padding-left: 12px;
        border-left: 1px solid rgba(255,255,255,.24);
      }
      .tone-green-soft .stage-metrics > div,
      .tone-green-final .stage-metrics > div {
        border-left-color: rgba(33,40,58,.13);
      }
      .metric-label {
        display: block;
        font-size: .64rem;
        line-height: 1.15;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .09em;
        opacity: .72;
      }
      .stage-metrics strong {
        display: block;
        margin-top: 4px;
        font-size: .78rem;
        line-height: 1.25;
      }
      .funnel-arrow {
        height: 23px;
        position: relative;
        display: grid;
        place-items: center;
        color: var(--prima);
        font-size: 1.1rem;
        font-weight: 950;
      }

      .pass-through-visual {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: auto auto;
        gap: 5px 8px;
        align-items: center;
        margin-top: 2px;
      }
      .example-rate {
        justify-self: end;
        font-size: .72rem;
        line-height: 1;
        font-weight: 950;
      }
      .pass-track {
        grid-column: 1 / -1;
        width: 100%;
        height: 5px;
        overflow: hidden;
        border-radius: 999px;
        background: rgba(255,255,255,.23);
      }
      .pass-fill {
        display: block;
        height: 100%;
        border-radius: inherit;
        background: rgba(255,255,255,.9);
      }
      .tone-green-soft .pass-track,
      .tone-green-final .pass-track {
        background: rgba(33,40,58,.12);
      }
      .tone-green-soft .pass-fill,
      .tone-green-final .pass-fill {
        background: rgba(33,40,58,.72);
      }

      .illustrative-curve {
        margin: 22px auto 0;
        max-width: 780px;
        padding: 18px 20px;
        background: var(--prima-soft);
        border: 1px solid #dbc7ef;
        border-radius: var(--radius-sm);
      }
      .illustrative-curve h3 { margin-top: 6px; font-size: 1.05rem; }
      .curve-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        align-items: end;
        margin-top: 18px;
      }
      .curve-point { display: grid; gap: 7px; text-align: center; align-items: end; }
      .curve-rate { font-size: .78rem; font-weight: 950; }
      .curve-bar {
        height: 74px;
        display: flex;
        align-items: end;
        justify-content: center;
        background: rgba(131,52,194,.08);
        border-radius: 8px 8px 4px 4px;
        overflow: hidden;
      }
      .curve-bar span {
        display: block;
        width: 100%;
        min-height: 4px;
        background: var(--prima);
        border-radius: 7px 7px 0 0;
      }
      .curve-point strong { font-size: .72rem; line-height: 1.2; }
      .funnel-example-caption {
        max-width: 780px;
        margin: 14px auto 0;
        color: var(--muted);
        font-size: .76rem;
        line-height: 1.45;
        text-align: center;
      }
      .funnel-example-caption strong { color: var(--ink); }

      .funnel-flow::before {
        content: 'Candidate volume narrows ↓  •  Pass-through rate rises ↑';
        display: block;
        margin: 0 auto 14px;
        color: var(--muted);
        font-size: .72rem;
        font-weight: 850;
        letter-spacing: .02em;
        text-align: center;
      }

      .funnel-rail { display: grid; gap: 14px; position: sticky; top: 90px; }
      .rail-card { padding: 20px; }
      .rail-card h3 { margin-top: 8px; font-size: 1.65rem; }
      .rail-list { display: grid; gap: 0; margin-top: 18px; }
      .rail-item {
        display: grid;
        grid-template-columns: 38px 1fr;
        gap: 10px;
        padding: 14px 0;
        border-top: 1px solid var(--line);
      }
      .rail-item:first-child { border-top: 0; padding-top: 0; }
      .rail-icon {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: var(--prima-soft);
        color: var(--prima);
        font-weight: 950;
      }
      .rail-item strong { display: block; font-size: .9rem; }
      .rail-item p { margin: 4px 0 0; color: var(--muted); font-size: .8rem; line-height: 1.42; }

      .rail-purple { background: var(--prima-navy); color: #fff; border-color: var(--prima-navy); }
      .rail-purple .eyebrow { color: #bcbfc8; }
      .question-list { display: grid; gap: 0; margin-top: 18px; }
      .question-item {
        display: grid;
        grid-template-columns: 34px 1fr;
        gap: 10px;
        align-items: start;
        padding: 13px 0;
        border-top: 1px solid rgba(255,255,255,.14);
      }
      .question-item span {
        color: #c59ce5;
        font-size: .68rem;
        font-weight: 900;
        letter-spacing: .08em;
      }
      .question-item strong { font-size: .86rem; line-height: 1.32; }

      .funnel-bottom {
        display: grid;
        grid-template-columns: minmax(240px, .7fr) minmax(0, 1.3fr);
        gap: 34px;
        align-items: end;
        background: var(--prima-soft);
        border-color: #dbc7ef;
      }
      .funnel-bottom h2 { margin-top: 10px; }
      .funnel-bottom p { max-width: 62ch; margin: 0; color: #353137; }
      .bottom-copy { display: grid; gap: 16px; }
      .conversion-principle {
        padding: 16px 18px;
        background: rgba(255,255,255,.72);
        border: 1px solid #dbc7ef;
        border-radius: var(--radius-sm);
      }
      .conversion-principle .eyebrow { color: var(--prima); }
      .conversion-principle p {
        margin-top: 7px;
        font-size: .9rem;
        line-height: 1.45;
        max-width: 68ch;
      }

      @media (min-width: 980px) {
        .funnel-layout { grid-template-columns: minmax(0, 1.55fr) minmax(280px, .45fr); }
      }

      @media (max-width: 979px) {
        .funnel-rail { position: static; }
      }

      @media (max-width: 759px) {
        .funnel-head .task-title { max-width: 10ch; }
        .funnel-kicker { grid-template-columns: 1fr; gap: 10px; }
        .funnel-stage {
          width: 100%;
          min-width: 0;
          grid-template-columns: 42px 1fr;
          gap: 11px;
          padding: 15px 14px;
          border-radius: 16px;
        }
        .stage-index { width: 36px; height: 36px; font-size: .74rem; }
        .stage-copy h3 { font-size: 1.08rem; }
        .stage-copy p { font-size: .73rem; }
        .stage-metrics {
          grid-column: 1 / -1;
          grid-template-columns: 1fr;
          gap: 8px;
          padding-top: 2px;
        }
        .stage-metrics > div {
          padding: 8px 0 0;
          border-left: 0;
          border-top: 1px solid rgba(255,255,255,.2);
        }
        .tone-green-soft .stage-metrics > div,
        .tone-green-final .stage-metrics > div {
          border-left: 0;
          border-top-color: rgba(33,40,58,.12);
        }
        .metric-label { display: block; margin-right: 0; font-size: .6rem; }
        .stage-metrics strong { display: block; margin-top: 4px; font-size: .74rem; }
        .pass-through-visual { margin-top: 2px; }
        .example-rate { font-size: .68rem; }
        .pass-track { height: 4px; }
        .curve-grid { gap: 8px; }
        .curve-bar { height: 58px; }
        .curve-point strong { font-size: .64rem; }
        .illustrative-curve { padding: 16px 12px; }
        .funnel-example-caption { font-size: .7rem; padding: 0 8px; }
        .funnel-arrow { height: 19px; font-size: 1rem; }
        .funnel-bottom { grid-template-columns: 1fr; gap: 16px; }
      }
    </style>
  </body>
</html>
