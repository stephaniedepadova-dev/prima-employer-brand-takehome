---
import '../styles/global.css';
import { nav } from '../layouts';

const sourceGroups = [
  {
    group: 'Prima / corporate & employer brand',
    items: [
      { label: 'Prima · Who we are', note: 'Corporate positioning, business and technology context.', url: 'https://www.prima.it/chi-siamo' },
      { label: 'Prima Careers', note: 'Main employer-brand ecosystem and candidate entry point.', url: 'https://www.helloprima.com/careers' },
      { label: 'PrimaLife', note: 'Culture, people, inclusion and employee experience.', url: 'https://www.helloprima.com/careers/primalife' },
      { label: 'Values', note: 'Five values and the behaviours Prima says guide how it works.', url: 'https://www.helloprima.com/about-us/values' },
      { label: 'Leadership', note: 'Leadership model, international organisation and collaboration.', url: 'https://www.helloprima.com/it/chi-siamo/leadership' },
      { label: 'Growth & Development', note: 'Competency framework, learning paths and career development.', url: 'https://www.helloprima.com/careers/growth-and-development' },
      { label: 'Benefits', note: 'Flexibility, working model, wellbeing and development support.', url: 'https://www.helloprima.com/careers/prima-benefits' },
      { label: 'Departments', note: 'Function-level propositions and role context.', url: 'https://www.helloprima.com/careers/departments' },
      { label: 'People', note: 'People function, employee voice and employer-brand proof.', url: 'https://www.helloprima.com/careers/departments/people' },
      { label: 'Locations', note: 'Italy, UK, Spain and international/remote context.', url: 'https://www.helloprima.com/careers/locations' },
      { label: 'International / Remote working', note: 'Global talent proposition and full-remote context.', url: 'https://www.helloprima.com/careers/locations/international' },
      { label: 'Jobs / Hiring process', note: 'Open roles, candidate guidance and public hiring framework.', url: 'https://www.helloprima.com/careers/jobs' },
      { label: 'Senior Python Software Engineer', note: 'The real vacancy selected for Task 2.', url: 'https://www.helloprima.com/careers/jobs/senior-python-software-engineer-77dc9214-4ed8-470e-93b0-4de8bbb1ccc4' },
      { label: 'Prima News & Events', note: 'Corporate, sponsorship and public event context.', url: 'https://www.helloprima.com/news-and-events' },
      { label: 'Prima Events', note: 'Talent-facing events and the company’s event proposition.', url: 'https://www.helloprima.com/news-and-events/events' },
      { label: 'Prima Press releases', note: 'Corporate announcements and sponsorship/business context.', url: 'https://www.helloprima.com/news-and-events/press-releases' },
    ],
  },
  {
    group: 'Prima / social & talent-facing channels',
    items: [
      { label: 'LinkedIn · Prima', note: 'Company page, employer-brand content and recent talent-facing posts.', url: 'https://www.linkedin.com/company/prima-assicurazioni/' },
      { label: 'LinkedIn · Life / Culture', note: 'Culture, people, EVP and employee-facing content.', url: 'https://www.linkedin.com/company/prima-assicurazioni/life/' },
      { label: 'LinkedIn · Jobs', note: 'Live job distribution and role visibility.', url: 'https://it.linkedin.com/company/prima-assicurazioni/jobs' },
      { label: 'LinkedIn · This is us / Riccardo Queri', note: 'Employee-led Product story reviewed in the cross-channel analysis.', url: 'https://www.linkedin.com/posts/prima-assicurazioni_this-is-us-meet-riccardo-queri-our-activity-7483112616693792769-RiFi' },
      { label: 'LinkedIn · Behind Prima / Raffaele Calandrella', note: 'Engineering leadership and lived-experience proof.', url: 'https://www.linkedin.com/posts/prima-assicurazioni_behind-prima-are-the-people-who-shape-how-activity-7425109642722078720-4UX5' },
      { label: 'Instagram · this_is_prima', note: 'Global employer-brand Instagram channel, including the screenshots reviewed.', url: 'https://www.instagram.com/this_is_prima/' },
      { label: 'YouTube · Prima', note: 'Channel, playlists and individual employer-brand videos reviewed.', url: 'https://www.youtube.com/@helloprima' },
    ],
  },
  {
    group: 'External perception / candidate signals',
    items: [
      { label: 'Glassdoor · Reviews', note: 'Employee reviews used as mixed, self-selected external signals.', url: 'https://www.glassdoor.it/Recensioni/Prima-Assicurazioni-Recensioni-E1395225.htm' },
      { label: 'Glassdoor · Interviews', note: 'Candidate interview experiences and process perceptions.', url: 'https://www.glassdoor.it/Colloquio/Prima-Assicurazioni-Domande-di-colloquio-E1395225.htm' },
      { label: 'Glassdoor · Example review', note: 'One specific review was inspected as part of the mixed-signal analysis.', url: 'https://www.glassdoor.it/Recensione-dipendente-Prima-Assicurazioni-E1395225-RVW89908160.htm' },
      { label: 'Indeed · Prima Assicurazioni', note: 'Reviews, Q&A and employee-generated workplace signals.', url: 'https://it.indeed.com/cmp/Prima-Assicurazioni' },
      { label: 'Indeed · Interview Q&A', note: 'Candidate-facing interview questions and user-generated signals.', url: 'https://it.indeed.com/cmp/Prima-Assicurazioni/faq/interviews' },
      { label: 'Great Place to Work · Prima Assicurazioni', note: 'External employer-brand recognition and employee voice.', url: 'https://www.greatplacetowork.it/scheda_azienda/prima-assicurazioni/' },
    ],
  },
  {
    group: 'Talent communities / university engagement / events',
    items: [
      { label: 'Joinrs · Prima Assicurazioni / Most Attractive Companies 2026', note: 'Talent perception, employer proposition and Math Fest context.', url: 'https://focus.joinrs.com/most-attractive-companies-2026/prima-assicurazioni-most-attractive-companies-2026' },
      { label: 'Joinrs · Most Attractive Companies 2026', note: 'Broader context for the talent-audience initiative.', url: 'https://focus.joinrs.com/most-attractive-companies-2026' },
      { label: 'SISSA · Prima Math Fest 2025', note: 'Independent university source describing the Math Fest experience.', url: 'https://www.sissa.it/it/news/prima-math-fest-2025' },
    ],
  },
  {
    group: 'Exploratory benchmark research',
    items: [
      { label: 'Mollie Careers', note: 'Final benchmark: role context, career proof and hiring transparency.', url: 'https://jobs.mollie.com/' },
      { label: 'Mollie · Vacancies', note: 'Vacancy-level benchmark and public hiring journey.', url: 'https://jobs.mollie.com/vacancies' },
      { label: 'Mollie · Full Stack Engineer II', note: 'Role-level example used to study proximity of proof.', url: 'https://jobs.mollie.com/vacancies/2fa761ee-3fe0-423c-aaa2-4e9e31871ef6' },
      { label: 'Mollie · Alicia Zavalis career story', note: 'Internal mobility and non-linear career progression example.', url: 'https://jobs.mollie.com/articles/from-rio-to-lisbon-and-back-to-mollie-alicia-zavalis-journey-of-courage-and-career-growth' },
      { label: 'Wise · Careers', note: 'Exploratory benchmark reference; not selected as final benchmark.', url: 'https://wise.jobs/' },
      { label: 'N26 · Careers', note: 'Exploratory benchmark reference; not selected as final benchmark.', url: 'https://n26.com/en-eu/careers' },
      { label: 'Revolut · Careers', note: 'Exploratory benchmark reference; not selected as final benchmark.', url: 'https://www.revolut.com/careers/' },
    ],
  },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f5f1" />
    <meta name="description" content="Public sources and research method used for the Prima Employer Branding Manager take-home assignment." />
    <title>Sources & method</title>
  </head>
  <body class="sources-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href="/prima-employer-brand-takehome/">PRIMA</a>
        <nav class="nav" aria-label="Primary navigation">
          {nav.map((item) => <a href={`/prima-employer-brand-takehome${item.href}`} aria-current={item.href === '/sources/' ? 'page' : undefined}>{item.label}</a>)}
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="task-hero">
        <div class="shell task-head sources-head">
          <div class="task-number"><span class="eyebrow">Sources & method</span></div>
          <h1 class="sources-title">Evidence first.</h1>
          <p class="lead">I used public sources to test the diagnosis, compare relevant employer-brand examples and build the redesign. The list below covers the public source set used across the research, including social channels, external perception and talent-facing initiatives.</p>
        </div>
      </section>

      <section class="section">
        <div class="shell source-list">
          {sourceGroups.map((group) => (
            <section class="surface card source-group">
              <div class="eyebrow">{group.group}</div>
              {group.items.map((item) => (
                <a class="source-link source-link-detailed" href={item.url} target="_blank" rel="noreferrer">
                  <span>
                    <strong>{item.label}</strong>
                    <small>{item.note}</small>
                  </span>
                  <span aria-hidden="true">↗</span>
                </a>
              ))}
            </section>
          ))}
        </div>
      </section>

      <section class="section">
        <div class="shell grid two">
          <article class="surface card">
            <div class="eyebrow">How I used AI</div>
            <h3 style="margin-top:10px">AI supported the process. The judgement stayed mine.</h3>
            <p class="small" style="margin-top:10px">I used AI to organise research, stress-test hypotheses, compare public employer-brand examples and iterate on copy and UX ideas. I reviewed the final outputs against the underlying evidence and removed unsupported claims.</p>
          </article>
          <article class="surface card card-dark">
            <div class="eyebrow" style="color:#aaa">Method</div>
            <p style="margin-top:12px;font-size:1.2rem;font-weight:850;line-height:1.15">I prioritised evidence over completeness, and observations over assumptions.</p>
            <p style="margin-top:10px;color:#cfcfcf">Public reviews and engagement metrics were treated as signals, not as representative population data or conversion evidence.</p>
          </article>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell"><div class="eyebrow">Take-home</div><p style="margin-top:8px">Employer Branding Manager – Take-home Assignment</p></div>
    </footer>

    <style>
      @media (min-width: 1100px) {
        .sources-head { grid-template-columns: 1fr; gap: 18px; align-items: start; }
        .sources-head > * { justify-self: start; }
        .sources-title { max-width: 12ch; }
      }
      .source-link-detailed { align-items: flex-start; }
      .source-link-detailed strong { display: block; font-size: .86rem; }
      .source-link-detailed small { display: block; margin-top: 4px; color: var(--muted); font-size: .72rem; line-height: 1.4; }
    </style>
  </body>
</html>
