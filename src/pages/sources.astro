---
import '../styles/global.css';
import { nav } from '../layouts';

const sourceGroups = [
  {
    group: 'Prima / corporate & employer brand',
    items: [
      { label: 'Prima · About us', note: 'Corporate positioning, technology-led insurance and international context.', url: 'https://www.helloprima.com/about-us' },
      { label: 'Prima Careers', note: 'Main employer-brand ecosystem and candidate entry point.', url: 'https://www.helloprima.com/careers' },
      { label: 'PrimaLife', note: 'Culture, people, inclusion and employee experience.', url: 'https://www.helloprima.com/careers/primalife' },
      { label: 'Values', note: 'Five values and the behaviours Prima says guide how it works.', url: 'https://www.helloprima.com/about-us/values' },
      { label: 'Leadership', note: 'Leadership model, international organisation and collaboration.', url: 'https://www.helloprima.com/about-us/leadership' },
      { label: 'Growth & Development', note: 'Competency framework, learning pathways and career development.', url: 'https://www.helloprima.com/careers/growth-and-development' },
      { label: 'Benefits', note: 'Flexibility, working model, wellbeing and development support.', url: 'https://www.helloprima.com/careers/prima-benefits' },
      { label: 'Departments', note: 'Function-level propositions and role context.', url: 'https://www.helloprima.com/careers/departments' },
      { label: 'Engineering', note: 'Engineering team proposition, technology scope and role context.', url: 'https://www.helloprima.com/careers/departments/engineering' },
      { label: 'People', note: 'People function, employee experience and employer-brand proof.', url: 'https://www.helloprima.com/careers/departments/people' },
      { label: 'Locations', note: 'Italy, Spain, the UK and international working context.', url: 'https://www.helloprima.com/careers/locations' },
      { label: 'International / Remote working', note: 'Global talent proposition and full-remote context.', url: 'https://www.helloprima.com/careers/locations/international' },
      { label: 'Jobs / Hiring', note: 'Open roles, candidate guidance and the public hiring entry point.', url: 'https://www.helloprima.com/careers/jobs' },
      { label: 'Senior Python Software Engineer', note: 'The real vacancy selected for Task 2.', url: 'https://www.helloprima.com/careers/jobs/senior-python-software-engineer-77dc9214-4ed8-470e-93b0-4de8bbb1ccc4' },
      { label: 'News & Events', note: 'Corporate, technology, sponsorship and public event context.', url: 'https://www.helloprima.com/news-and-events' },
      { label: 'Events', note: 'Talent-facing events and Prima’s event proposition.', url: 'https://www.helloprima.com/news-and-events/events' },
      { label: 'Press releases', note: 'Public announcements and business context reviewed during the research.', url: 'https://www.helloprima.com/news-and-events/press-releases' },
      { label: 'Prima Math Fest', note: 'English-language university and talent-engagement example.', url: 'https://www.helloprima.com/news-and-events/events/prima-math-fest' },
    ],
  },
  {
    group: 'Prima / social & talent-facing channels',
    items: [
      { label: 'LinkedIn · Prima', note: 'Company page, employer-brand content and talent-facing posts.', url: 'https://www.linkedin.com/company/prima-assicurazioni/' },
      { label: 'LinkedIn · Life / Culture', note: 'Culture, people, EVP and employee-facing content.', url: 'https://www.linkedin.com/company/prima-assicurazioni/life/' },
      { label: 'LinkedIn · Jobs', note: 'Live job distribution and role visibility.', url: 'https://www.linkedin.com/company/prima-assicurazioni/jobs/' },
      { label: 'LinkedIn · This is us / Riccardo Queri', note: 'Employee-led Product story reviewed in the cross-channel analysis.', url: 'https://www.linkedin.com/posts/prima-assicurazioni_this-is-us-meet-riccardo-queri-our-activity-7483112616693792769-RiFi' },
      { label: 'LinkedIn · Behind Prima / Raffaele Calandrella', note: 'Engineering leadership and lived-experience proof.', url: 'https://www.linkedin.com/posts/prima-assicurazioni_behind-prima-are-the-people-who-shape-how-activity-7425109642722078720-4UX5' },
      { label: 'Instagram · this_is_prima', note: 'Global employer-brand Instagram channel reviewed during the cross-channel analysis.', url: 'https://www.instagram.com/this_is_prima/' },
      { label: 'YouTube · Prima', note: 'Channel, playlists and employer-brand videos reviewed.', url: 'https://www.youtube.com/@helloprima' },
    ],
  },
  {
    group: 'External perception / candidate signals',
    items: [
      { label: 'Glassdoor · Reviews', note: 'Employee reviews used as mixed, self-selected external signals.', url: 'https://www.glassdoor.com/Reviews/Prima-Assicurazioni-Reviews-E1395225.htm' },
      { label: 'Glassdoor · Interviews', note: 'Candidate interview experiences and process perceptions.', url: 'https://www.glassdoor.com/Interview/Prima-Assicurazioni-Interview-Questions-E1395225.htm' },
    ],
  },
  {
    group: 'Final benchmark',
    items: [
      { label: 'Mollie Careers', note: 'Final benchmark for role context, career proof and hiring transparency.', url: 'https://jobs.mollie.com/' },
      { label: 'Mollie · Vacancies', note: 'Vacancy-level benchmark and public hiring journey.', url: 'https://jobs.mollie.com/vacancies' },
      { label: 'Mollie · Full Stack Engineer II', note: 'Role-level example used to study proximity of proof to candidate decisions.', url: 'https://jobs.mollie.com/vacancies/2fa761ee-3fe0-423c-aaa2-4e9e31871ef6' },
      { label: 'Mollie · Alicia Zavalis career story', note: 'Career progression and internal-mobility example.', url: 'https://jobs.mollie.com/articles/from-rio-to-lisbon-and-back-to-mollie-alicia-zavalis-journey-of-courage-and-career-growth' },
    ],
  },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f5f1" />
    <meta name="description" content="Public sources and research method used for the Prima Employer Branding Manager take-home assignment." />
    <title>Sources & method</title>
  </head>
  <body class="sources-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href="/prima-employer-brand-takehome/">PRIMA</a>
        <nav class="nav" aria-label="Primary navigation">
          {nav.map((item) => <a href={`/prima-employer-brand-takehome${item.href}`} aria-current={item.href === '/sources/' ? 'page' : undefined}>{item.label}</a>)}
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="task-hero">
        <div class="shell task-head sources-head">
          <div class="task-number"><span class="eyebrow">Sources & method</span></div>
          <h1 class="sources-title">Evidence first.</h1>
          <p class="lead sources-lead">I used public sources to test the diagnosis, compare relevant employer-brand examples and build the redesign. This page lists the public evidence that directly underpins the final assignment.</p>
        </div>
      </section>

      <section class="section">
        <div class="shell source-list">
          {sourceGroups.map((group) => (
            <section class="surface card source-group">
              <div class="eyebrow source-group-title">{group.group}</div>
              <div class="source-items">
                {group.items.map((item) => (
                  <a class="source-link source-link-detailed" href={item.url} target="_blank" rel="noreferrer">
                    <span class="source-copy">
                      <strong>{item.label}</strong>
                      <small>{item.note}</small>
                    </span>
                    <span class="source-arrow" aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      </section>

      <section class="section">
        <div class="shell grid two">
          <article class="surface card">
            <div class="eyebrow">How I used AI</div>
            <h3 style="margin-top:10px">AI supported the process. The judgement stayed mine.</h3>
            <p class="small" style="margin-top:10px">I used AI to organise research, stress-test hypotheses, compare public employer-brand examples and iterate on copy and UX ideas. I reviewed the final outputs against the underlying evidence and removed unsupported claims.</p>
          </article>
          <article class="surface card card-dark">
            <div class="eyebrow" style="color:#aaa">Method</div>
            <p style="margin-top:12px;font-size:1.2rem;font-weight:850;line-height:1.15">I prioritised evidence over completeness, and observations over assumptions.</p>
            <p style="margin-top:10px;color:#cfcfcf">Public reviews were treated as directional signals, not as representative population data.</p>
            <p style="margin-top:10px;color:#cfcfcf">Additional employer-brand benchmarks were explored during the research phase; only Mollie is used as the final benchmark in the assignment.</p>
          </article>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell"><div class="eyebrow">Take-home</div><p style="margin-top:8px">Employer Branding Manager – Take-home Assignment</p></div>
    </footer>

    <style>
      .sources-head { gap: 20px; }
      .sources-title { max-width: none; width: 100%; margin: 0; justify-self: start; font-size: clamp(2.8rem, 8vw, 6.2rem); line-height: 1.02; letter-spacing: -.052em; }
      .sources-lead { max-width: 64ch; }
      .source-group { padding: 24px 28px; }
      .source-group-title { font-size: .78rem; letter-spacing: .12em; }
      .source-items { margin-top: 10px; }
      .source-link-detailed { display: grid !important; grid-template-columns: minmax(0,1fr) auto; gap: 18px; align-items: center; padding: 17px 0; border-top: 1px solid var(--line); text-decoration: none !important; color: var(--text); }
      .source-link-detailed:first-child { border-top: 0; }
      .source-copy { min-width: 0; }
      .source-link-detailed strong { display: block; font-size: 1.05rem; line-height: 1.25; font-weight: 900; letter-spacing: -.02em; }
      .source-link-detailed small { display: block; margin-top: 5px; color: var(--muted); font-size: .88rem; line-height: 1.45; }
      .source-arrow { display: grid; place-items: center; width: 30px; height: 30px; border: 1px solid var(--line); border-radius: 50%; color: var(--prima); font-size: .9rem; font-weight: 900; }
      .source-link-detailed:hover .source-link-detailed strong { color: var(--prima); }
      .source-link-detailed:hover .source-arrow { border-color: #cdb6df; background: var(--prima-soft); }
      @media (max-width: 759px) {
        .sources-title { font-size: clamp(2.7rem, 13vw, 4.4rem); }
        .source-group { padding: 20px 18px; }
        .source-group-title { font-size: .72rem; }
        .source-link-detailed { gap: 12px; padding: 15px 0; }
        .source-link-detailed strong { font-size: .98rem; }
        .source-link-detailed small { font-size: .82rem; }
        .source-arrow { width: 28px; height: 28px; font-size: .82rem; }
      }
    </style>
  </body>
</html>
