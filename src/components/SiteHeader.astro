---
import { nav } from '../layouts';
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href="/talent-employer-brand-strategy-prima/">PRIMA</a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" aria-label="Open navigation">
      <span></span><span></span><span></span>
    </button>
    <nav class="nav" id="primary-navigation" aria-label="Primary navigation">
      {nav.map((item) => <a href={`/talent-employer-brand-strategy-prima${item.href}`}>{item.label}</a>)}
    </nav>
  </div>
</header>
<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.querySelector('#primary-navigation');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Open navigation' : 'Close navigation');
    nav?.classList.toggle('is-open', !open);
  });
</script>